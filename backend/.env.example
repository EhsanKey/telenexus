# ==============================================================================
# TeleNexus — Backend Environment Configuration
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Backend HTTP Server Listening Port (Default: 4000)
PORT=4000

# ------------------------------------------------------------------------------
# 1. Neon Serverless PostgreSQL Database Connection
# ------------------------------------------------------------------------------
# Obtain connection string from your Neon Console (https://console.neon.tech).
# SSL mode 'require' is strongly recommended for production.
DATABASE_URL=postgresql://username:password@ep-sample-project.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 2. Telegram MTProto User API Credentials
# ------------------------------------------------------------------------------
# Obtain your API ID and API Hash from https://my.telegram.org under "API development tools".
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789

# 32-byte secret passphrase used for AES-256-GCM encryption of MTProto session strings at rest
# Generate a strong key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_SESSION_SECRET=super_secret_32_byte_hex_or_string_key_here

# ------------------------------------------------------------------------------
# 3. Network Proxy Configuration (Optional)
# ------------------------------------------------------------------------------
# If you are operating in a network-filtered region, specify SOCKS5/HTTP proxy details below.
# TELEGRAM_PROXY_HOST=127.0.0.1
# TELEGRAM_PROXY_PORT=1080
# TELEGRAM_PROXY_SECRET=

# ------------------------------------------------------------------------------
# 4. Google Drive OAuth 2.0 Integration (Cloud Backup & Excel CRM Sync)
# ------------------------------------------------------------------------------
# Configure OAuth 2.0 Client ID & Secret from Google Cloud Console (https://console.cloud.google.com).
# Ensure the Google Drive API is enabled and the authorized redirect URI is configured.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/backend/backups/drive/callback

# ------------------------------------------------------------------------------
# 5. Frontend Origin / CORS
# ------------------------------------------------------------------------------
# Allowed origins for Cross-Origin Resource Sharing (CORS)
FRONTEND_URL=http://localhost:3000
