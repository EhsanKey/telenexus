# ==============================================================================
# TeleNexus — Frontend Environment Configuration
# ==============================================================================

# Next.js Server Port (Default: 3000)
PORT=3000

# Upstream Backend API Target for Reverse Proxy Route Handlers (/api/backend/*)
# In local development: http://localhost:4000/api/v1 (or http://127.0.0.1:4000/api/v1)
# In production / Docker: http://backend:4000/api/v1 or https://api.yourdomain.com/api/v1
BACKEND_API_URL=http://localhost:4000/api/v1

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development
